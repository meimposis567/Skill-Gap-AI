# ─── Frontend environment variables (Vite) ───
# Copy this file to `.env` and fill in real values.
# Anything prefixed with VITE_ is exposed to the browser bundle —
# never put private/server-side secrets here.

# Base URL of the Node.js backend API
VITE_API_URL=http://localhost:5000/api

# Optional: NewsAPI key for the tech-news widget (https://newsapi.org)
VITE_NEWS_API_KEY=

# Optional: Adzuna job-listings API credentials (https://developer.adzuna.com)
VITE_ADZUNA_APP_ID=
VITE_ADZUNA_APP_KEY=
